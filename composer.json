{
    "name": "vonheldenundgestalten/contao-schema-manager",
    "description": "Shared Schema.org entities and localized page assignments for Contao.",
    "type": "contao-bundle",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "contao/core-bundle": "^5.7",
        "doctrine/dbal": "^3.6 || ^4.0",
        "spatie/schema-org": "^3.10 || ^4.0",
        "symfony/http-client": "^6.4 || ^7.0",
        "symfony/dotenv": "^6.4 || ^7.0"
    },
    "autoload": {
        "psr-4": {
            "VHUG\\SchemaManagerBundle\\": "src/"
        }
    },
    "extra": {
        "contao-manager-plugin": "VHUG\\SchemaManagerBundle\\ContaoManager\\Plugin"
    },
    "conflict": {
        "contao/manager-plugin": "<2.0 || >=3.0"
    },
    "scripts": {
        "test": [
            "@php tests/mapper.php",
            "@php tests/manual-products.php",
            "@php tests/jobs.php",
            "@php tests/business-mapper.php",
            "@php tests/relationship-map.php",
            "@php tests/content-relationship-map.php"
        ]
    }
}
