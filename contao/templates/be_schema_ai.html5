<?php
$e=static fn($value)=>htmlspecialchars((string)$value,ENT_QUOTES|ENT_SUBSTITUTE,'UTF-8');
$l=$this->l;$run=$this->run;$stage=$this->stage;$configuration=!empty($run['configuration']);
$token='<input type="hidden" name="REQUEST_TOKEN" value="'.$e($this->token).'">';
$name=static function($key)use($run){
    if(str_contains($key,'@')){[$parent,$page]=explode('@',$key,2);$key=$parent;$suffix=' · '.($run['inventory']['pages'][(int)$page]['title'] ?? $page);}else{$suffix='';}
    $r=$run['inventory']['records'][$key] ?? [];
    if(str_starts_with($key,'translation:')){$parent=$run['inventory']['records']['entity:'.$r['pid']] ?? [];$r['name']=$parent['name'] ?? $key;}
    foreach($run['proposals'] ?? [] as $p){if($p['action']==='create' && $p['target']===$key){return $p['value'].$suffix;}}
    return html_entity_decode((string)($r['name'] ?? $r['headline'] ?? $r['title'] ?? $run['inventory']['sources'][$key]['title'] ?? $key),ENT_QUOTES|ENT_HTML5,'UTF-8').$suffix;
};
$fieldLabel=static function($p)use($l){
    if($p['action']==='create')return $p['field'];
    if($p['action']==='home')return $l['home'];
    $table=match(true){str_starts_with($p['target'],'author:')=>'tl_user',str_starts_with($p['target'],'archive:')=>'tl_news_archive',str_starts_with($p['target'],'calendar:')=>'tl_calendar',str_starts_with($p['target'],'event:')=>'tl_calendar_events',str_starts_with($p['target'],'root:')||str_starts_with($p['target'],'page:')=>'tl_page',str_contains($p['target'],'@')||str_starts_with($p['target'],'translation:')=>'tl_schema_translation',str_starts_with($p['target'],'news:')=>'tl_news',default=>'tl_schema_entity'};
    return $GLOBALS['TL_LANG'][$table][$p['field']][0] ?? $p['field'];
};
$display=static function($value,$p)use($name,$run,$l){
    if(in_array($p['field'],['schemaPublisher','schemaOrganizer'],true))return $run['organizations'][(int)$value]['name'] ?? ((int)$value?'#'.$value:$l['noPublisher']);
    if($p['field']==='schemaMode')return $value ?: $l['coreEventType'];
    if($p['field']==='schemaType')return $value ?: $l['coreType'];
    if($p['action']==='home'){return $run['inventory']['pages'][(int)$value]['title'] ?? $value;}
    if($p['action']==='add'){
        if(is_string($value) && preg_match('/^(?:entity:|new:)/',$value))return $name($value);
        $values=\Contao\StringUtil::deserialize($value,true);return implode(', ',array_map(static fn($id)=>$name('entity:'.$id),$values));
    }
    return is_array($value)?json_encode($value):($value ?: '—');
};
$renderKey=function()use($e,$l,$token):void { ?>
<section><h3><?= $e($l['keyTitle']) ?></h3><p><?= $e($l[$this->hasKey?'keyPresent':'keyMissing']) ?> · <?= $e($this->model) ?></p>
<details <?= $this->hasKey?'':'open' ?>><summary><?= $e($l[$this->hasKey?'replaceKey':'saveKey']) ?></summary>
<form method="post" data-turbo="false" autocomplete="off"><?= $token ?><input type="hidden" name="ai_action" value="key">
<label><?= $e($l['keyTitle']) ?><input type="password" name="api_key" autocomplete="new-password" required maxlength="515" placeholder="sk-…"></label>
<p><?= $e($l['keyHelp']) ?></p><button class="tl_submit"><?= $e($l['saveKey']) ?></button></form></details></section>
<?php };
?>
<div class="sai" data-schema-ai>
<header><h2><?= $e($l['title']) ?></h2><a href="?do=schema_manager"><?= $e($l['back']) ?></a></header>
<p><?= $e($l['intro']) ?></p>
<?php if($stage==='content'&&!$this->hasPublishedOrganization): ?><p class="tl_info"><?= $e($l['foundationDraftWarning']) ?></p><?php endif ?>
<nav class="sai-stages" aria-label="<?= $e($l['stages']) ?>"><?php foreach(['foundation','configuration','content'] as $step): ?><a href="?do=schema_manager&amp;key=ai&amp;stage=<?= $step ?>&amp;root=<?= (int)$this->selectedRoot ?>" <?= $stage===$step?'aria-current="step"':'' ?>><strong><?= $e($l['stage_'.$step]) ?></strong><span><?= $e($l['stage_'.$step.'_help']) ?></span></a><?php endforeach ?></nav>

<?php if($this->error): ?><p class="tl_error" role="alert"><?= $e($this->error) ?></p><?php endif ?>
<?php if($this->message): ?><p class="tl_confirm" role="status"><?= $e($this->message) ?></p><?php endif ?>
<?php if(!$this->hasKey) { $renderKey(); } ?>
<?php if(!$this->installed): ?><p class="tl_info"><?= $e($l['migrate']) ?></p><?php endif ?>
<?php if(($this->hasKey||$stage==='configuration') && $this->installed && !$run): ?>
<section><h3><?= $e($l['stage_'.$stage]) ?></h3><p><?= $e($l['stage_'.$stage.'_help']) ?></p><form method="post" data-turbo="false"><?= $token ?><input type="hidden" name="ai_action" value="start"><input type="hidden" name="stage" value="<?= $e($stage) ?>">
<div class="sai-fields"><label><?= $e($l['root']) ?><select name="root" required><?php foreach($this->roots as $root=>$title): ?><option value="<?= (int)$root ?>" <?= (int)$root===(int)$this->selectedRoot?'selected':'' ?>><?= $e($title) ?> (#<?= (int)$root ?>)</option><?php endforeach ?></select></label>
<?php if($stage!=='configuration'): ?><label><?= $e($l['origin']) ?><input name="origin" type="url" required value="<?= $e($this->origin) ?>" placeholder="https://www.example.org"></label><?php endif ?></div><?php if($stage!=='configuration'): ?><p><?= $e($l['originHelp']) ?></p>
<label><input type="radio" name="mode" value="discover" <?= $stage==='foundation'&&$this->hasOrganizations?'':'checked' ?>> <?= $e($l['discover']) ?></label>
<label><input type="radio" name="mode" value="improve" <?= $stage==='foundation'&&$this->hasOrganizations?'checked':'' ?>> <?= $e($l['improve']) ?></label>
<?php endif ?><label><input type="checkbox" name="multilingual" value="1" checked> <?= $e($l['multilingual']) ?></label><p class="sai-hint"><?= $e($l['multilingualHelp']) ?></p>
<?php if($stage==='content'): ?><label><input type="checkbox" name="changed" value="1" checked> <?= $e($l['changed']) ?></label><?php endif ?>
<?php if($stage!=='configuration'): ?><p><?= $e($l['coverage']) ?></p><?php endif ?><p><?= $e($l['noAutomatic']) ?></p><button class="tl_submit"><?= $e($l[$stage==='configuration'?'reviewParents':'prepare']) ?></button></form></section>
<?php endif ?>
<?php if($run): ?>
<?php if($configuration): ?><p class="tl_info"><?= $e($l['parentReviewHelp']) ?></p><?php foreach($run['calendars'] ?? [] as $calendar): ?><p class="tl_info"><?= $e($calendar['title']) ?>: <?= $e($l['calendarDeferred']) ?></p><?php endforeach ?><?php endif ?>
<section class="sai-run-summary"><h3><?= $e($l['run']) ?> #<?= (int)$this->runId ?></h3>
<?php if($configuration): ?><p><?= $e($l['parentSummary']) ?></p><?php else: ?><p><?= $e($l['status']) ?>: <?= $e($l[$run['status']] ?? $run['status']) ?> · <?= count($run['inventory']['sources']) ?> <?= $e($l['sources']) ?> · <?= (count($run['queue'])+count($run['localizationQueue'] ?? [])) ?> <?= $e($l['remaining']) ?></p><?php endif ?>
<?php if(($run['queue'] || !empty($run['localizationQueue'])) && $this->hasKey): ?><form method="post" data-sai-run data-cursor="<?= $e(\VHUG\SchemaManagerBundle\Ai\AnalysisRunner::cursor($run)) ?>" data-waiting-label="<?= $e($l['waitingBatch']) ?>" data-phase="<?= !$run['queue']&&!empty($run['localizationQueue'])?'localize':'analyze' ?>" data-translation-label="<?= $e($l['localizing']) ?>" data-total="<?= ($run['sourceTotal'] ?? count($run['inventory']['sources']))+($run['localizationTotal'] ?? 0) ?>" data-remaining="<?= (count($run['queue'])+count($run['localizationQueue'] ?? [])) ?>" data-turbo="false"><?= $token ?><input type="hidden" name="ai_action" value="step"><p><?= $e($l['disclosure']) ?></p><p role="status" data-sai-loading><?= $e($l['controlsLoading']) ?></p><button type="button" class="tl_submit" disabled data-sai-start><?= $e($l['continue']) ?></button> <button type="button" class="tl_submit" data-sai-stop hidden><?= $e($l['stop']) ?></button><p role="status" data-sai-progress data-label="<?= $e($l['progress']) ?>"></p></form><?php endif ?>
<?php if(!$configuration): ?><details><summary><?= $e($l['analysisDetails']) ?></summary><p><?= $e($l['usage']) ?>: <?= (int)$run['usage']['input_tokens'] ?> <?= $e($l['input']) ?> / <?= (int)$run['usage']['output_tokens'] ?> <?= $e($l['output']) ?>.<br><?= $e($l['cost']) ?>: $<?= number_format(($run['usage']['input_tokens']*2+$run['usage']['output_tokens']*10)/1000000,4) ?></p>
<?php foreach($run['warnings'] as $warning): ?><p class="tl_info"><?= $e($warning) ?></p><?php endforeach ?>

<details><summary><?= $e($l['sources']) ?></summary><ul><?php foreach($run['inventory']['sources'] as $source): ?><li><strong><?= $e($source['title']) ?></strong> · <?= $e($source['language']) ?> · <?= $e($source['id']) ?><details><summary><?= $e($l['evidence']) ?></summary><p><?= $e($source['coverage']) ?></p><p><?= $e($source['text']) ?></p></details></li><?php endforeach ?></ul></details>
</details><?php endif ?></section>
<section class="sai-review-section"><h3><?= $e($l['review']) ?></h3><p><?= $e($l[$configuration?'parentSelectionHelp':'selectHelp']) ?></p>
<?php if(!$run['proposals']): ?><p><?= $e($l['empty']) ?></p><?php else: ?>
<form method="post" data-sai-review data-turbo="false"><?= $token ?>
<?php
$groups=[];$creations=[];$homes=[];
foreach($run['proposals'] as $i=>$p){
 if($p['status']==='pending' && $p['action']==='create')$creations[$p['target']]=$i;
 if($p['status']==='pending' && $p['action']==='home')$homes[$p['target'].'@'.$p['value']]=$i;
 $key=explode('@',$p['target'],2)[0];
 if(str_starts_with($key,'translation:'))$key='entity:'.($run['inventory']['records'][$key]['pid'] ?? $key);
 $groups[$key][$i]=$p;
}
$pending=count(array_filter($run['proposals'],static fn($p)=>$p['status']==='pending'));
?>
<div class="sai-review-toolbar">
<strong role="status" data-sai-count data-label="<?= $e($l['selectedCount']) ?>">0 <?= $e($l['selectedCount']) ?></strong>
<div class="sai-actions"><button class="tl_submit sai-primary" name="ai_action" value="apply"><?= $e($l['apply']) ?></button><button class="tl_submit" name="ai_action" value="reject"><?= $e($l['reject']) ?></button></div>
</div>
<p class="sai-review-help"><?= $e($l[$configuration?'parentApplyHelp':'applyHelp']) ?></p>
<div class="sai-actions sai-selection"><button type="button" class="tl_submit" data-sai-all><?= $e($l['selectAll']) ?></button><button type="button" class="tl_submit" data-sai-clear><?= $e($l['clear']) ?></button></div>
<?php foreach($groups as $groupKey=>$items):
$groupPending=count(array_filter($items,static fn($p)=>$p['status']==='pending'));
$groupRecord=$run['inventory']['records'][$groupKey] ?? [];
$groupType=match(strstr($groupKey,':',true)) {
 'author'=>$l['authorGroup'],
 'root'=>'WebSite',
 'archive'=>$l['archiveGroup'],
 'calendar'=>$l['calendarGroup'],
 'event'=>'Event',
 'news'=>$groupRecord['_mode'] ?? 'Article',
 'page'=>($groupRecord['schemaPageType'] ?? '') ?: 'WebPage',
 default=>$groupRecord['entityType'] ?? 'Thing',
};
$groupTitle=($configuration?$l['reviewSetting']:$l['updateGroup']).' '.$groupType.' “'.$name($groupKey).'”';
foreach($items as $item){if($item['action']==='create'){$groupTitle=$l['newGroup'].' '.$item['field'].' “'.$item['value'].'”';break;}}
?>
<details class="sai-entity"><summary><span class="sai-entity-name"><?= $e($groupTitle) ?></span><span class="sai-badge"><?= $groupPending ?> <?= $e($l['toReview']) ?></span></summary>
<?php if(!empty($run['reviewNotes'][$groupKey])): ?><p class="sai-editor-note"><strong><?= $e($l['editorReview']) ?>:</strong> <?= $e($run['reviewNotes'][$groupKey]) ?></p><?php endif ?>
<?php foreach($items as $i=>$p):
$source=$run['inventory']['sources'][$p['source']] ?? [];
$deps=[];$parent=explode('@',$p['target'],2)[0];
if($p['action']!=='create' && isset($creations[$parent]))$deps[]=$creations[$parent];
if($p['action']==='set' && isset($homes[$p['target']]))$deps[]=$homes[$p['target']];
if($p['action']==='add' && isset($creations[$p['value']]))$deps[]=$creations[$p['value']];
$help='';
if($p['action']==='add'){$helpTable=str_starts_with($p['target'],'news:')?'tl_news':(str_starts_with($p['target'],'page:')?'tl_page':'tl_schema_entity');$help=$GLOBALS['TL_LANG'][$helpTable][$p['field']][1] ?? '';}
$actionLabel=$configuration?$l['reviewSetting']:($p['action']==='create'?$l['createAction']:($p['action']==='home'?$l['homeAction']:($p['action']==='add'?$l['linkAction']:(empty($p['old'])?$l['fillAction']:$l['replaceAction']))));
?>
<article class="sai-proposal <?= $p['status']==='pending'?'':'sai-inactive' ?>">
<div class="sai-proposal-heading">
<?php if($p['status']==='pending'): ?><input id="sai-p-<?= (int)$i ?>" type="checkbox" name="selected[]" value="<?= (int)$i ?>" data-depends="<?= $e(json_encode($deps)) ?>" data-bulk="1" aria-label="<?= $e($name($p['target']).': '.$actionLabel.' '.$fieldLabel($p)) ?>"><?php endif ?>
<div><span class="sai-action-label"><?= $e($actionLabel) ?><?php $localePage=$p['action']==='home'?(int)$p['value']:(str_contains($p['target'],'@')?(int)substr(strrchr($p['target'],'@'),1):0);if($localePage): ?> · <?= $e(strtoupper($run['inventory']['pages'][$localePage]['language'] ?? '')) ?><?php endif ?></span><h4><?php if($p['status']==='pending'): ?><label for="sai-p-<?= (int)$i ?>"><?= $e($fieldLabel($p)) ?></label><?php else: ?><?= $e($fieldLabel($p)) ?> <small><?= $e($l[$p['status']==='applied'?'appliedState':($p['status']==='rejected'?'rejectedState':$p['status'])] ?? $p['status']) ?></small><?php endif ?></h4></div>
</div>
<div class="sai-proposal-body">
<?php if($help): ?><p class="sai-hint"><?= $e($help) ?></p><?php endif ?>
<?php if($p['old']!=='' && $p['old']!==null): ?><div class="sai-old"><strong><?= $e($l['current']) ?></strong><div><?= nl2br($e($display($p['old'],$p))) ?></div></div><?php endif ?>
<div class="sai-proposed"><strong><?= $e($l[$configuration?'reviewValue':'proposed']) ?></strong><div data-sai-value="<?= (int)$i ?>"><?= nl2br($e($display($p['value'],$p))) ?></div></div>
<?php if($p['action']==='create'): ?><p class="sai-hint"><?= $e($l['draftHint']) ?></p><?php elseif($p['action']==='home'): ?><p class="sai-hint"><?= $e($l['homeHint']) ?></p><?php endif ?>
<p><strong><?= $e($l[$configuration?'effect':'reason']) ?>:</strong> <?= $e($configuration?($l[$p['reason']] ?? $p['reason']):$p['reason']) ?></p>
<?php if(!$configuration): ?><details><summary><?= $e($l['evidence'].': '.($source['title'] ?? $p['source'])) ?></summary><blockquote><?= $e($p['quote']) ?></blockquote><p><?= $e($source['url'] ?? '') ?></p></details><?php endif ?>
<?php if($configuration&&$p['status']==='pending'&&in_array($p['field'],['schemaPublisher','schemaOrganizer','schemaType','schemaMode','schemaEventStatus','schemaAttendanceMode'],true)): ?>
<label><?= $e($l['proposed']) ?><select name="value[<?= (int)$i ?>]" data-sai-edit="<?= (int)$i ?>">
<?php if(in_array($p['field'],['schemaPublisher','schemaOrganizer'],true)): ?><option value="0"><?= $e($l['noPublisher']) ?></option><?php foreach($run['organizations'] as $org): ?><option value="<?= (int)$org['id'] ?>" <?= (int)$p['value']===(int)$org['id']?'selected':'' ?>><?= $e($org['name'].(empty($org['published'])?' · '.$l['draftState']:'')) ?></option><?php endforeach ?>
<?php else: $options=match($p['field']){'schemaMode'=>[''=>$l['coreEventType'],'enrich'=>$l['enrichEvents'],'suppress'=>$l['suppressType']],'schemaEventStatus'=>array_combine(['','EventScheduled','EventCancelled','EventPostponed','EventRescheduled','EventMovedOnline'],['—','EventScheduled','EventCancelled','EventPostponed','EventRescheduled','EventMovedOnline']),'schemaAttendanceMode'=>array_combine(['','OfflineEventAttendanceMode','OnlineEventAttendanceMode','MixedEventAttendanceMode'],['—','OfflineEventAttendanceMode','OnlineEventAttendanceMode','MixedEventAttendanceMode']),default=>[''=>$l['coreType'],'Article'=>'Article','NewsArticle'=>'NewsArticle','BlogPosting'=>'BlogPosting','JobPosting'=>'JobPosting','suppress'=>$l['suppressType']]};foreach($options as $value=>$label): ?><option value="<?= $e($value) ?>" <?= $p['value']===$value?'selected':'' ?>><?= $e($label) ?></option><?php endforeach; endif ?></select></label>
<?php elseif($p['status']==='pending' && $p['action']==='set'): ?><details><summary><?= $e($l['editSuggestion']) ?></summary><label><?= $e($l['proposed']) ?><textarea name="value[<?= (int)$i ?>]" data-sai-edit="<?= (int)$i ?>"><?= $e($p['value']) ?></textarea></label></details><?php endif ?>
<?php if($p['error']): ?><p class="tl_error"><?= $e($p['error']) ?></p><?php endif ?>
</div></article>
<?php endforeach ?></details>
<?php endforeach ?>
</form>
<?php endif ?></section>
<?php endif ?>
<?php if($run&&!$configuration): ?>
<section class="sai-feedback"><h3><?= $e($l['feedbackTitle']) ?></h3>
<?php if(isset($run['refinementOf'])): ?><p><?= $e($l['alternativeReview']) ?> <a href="?do=schema_manager&amp;key=ai&amp;run=<?= (int)$run['refinementOf'] ?>"><?= $e($l['originalReview']) ?> #<?= (int)$run['refinementOf'] ?></a></p><?php endif ?>
<?php if(!empty($run['conversation'])): ?><details><summary><?= $e($l['conversation']) ?></summary><?php foreach($run['conversation'] as $turn): ?><div class="sai-chat-turn"><strong><?= $e($l[$turn['role']==='user'?'you':'assistant']) ?></strong><p><?= nl2br($e($turn['text'])) ?></p></div><?php endforeach ?></details><?php endif ?>
<?php if(!empty($run['explanation'])): ?><div class="sai-chat-turn"><strong><?= $e($l['assistant']) ?></strong><p><?= nl2br($e($run['explanation'])) ?></p></div><?php endif ?>
<?php $hasApplied=(bool)array_filter($run['proposals'],static fn($p)=>$p['status']==='applied'); ?>
<?php if($this->hasKey && $run['status']==='complete' && !$hasApplied): ?>
<p><?= $e($l['feedbackHelp']) ?></p>
<form method="post" data-sai-feedback data-turbo="false"><?= $token ?><input type="hidden" name="ai_action" value="refine">
<label><?= $e($l['feedbackLabel']) ?><textarea name="feedback" required maxlength="4000" placeholder="<?= $e($l['feedbackExample']) ?>"></textarea></label>
<p class="sai-hint"><?= $e($l['feedbackDisclosure']) ?></p><button class="tl_submit" type="submit"><?= $e($l['feedbackSend']) ?></button><p role="status" data-sai-feedback-status data-label="<?= $e($l['feedbackWorking']) ?>"></p>
</form>
<?php elseif($hasApplied): ?><p><?= $e($l['feedbackApplied']) ?></p><?php else: ?><p><?= $e($l['feedbackWait']) ?></p><?php endif ?>
</section>
<?php endif ?>
<?php if($this->recent): ?>
<section class="sai-recent"><h3><?= $e($l['recent']) ?></h3>
<ul class="sai-recent-list">
<?php foreach($this->recent as $item): $isCurrent=(int)$item['id']===(int)$this->runId; ?>
<li><a class="sai-recent-link" href="?do=schema_manager&amp;key=ai&amp;run=<?= (int)$item['id'] ?>" <?= $isCurrent?'aria-current="page"':'' ?>>
<span class="sai-recent-name"><strong><?= $e($l['run']) ?> #<?= (int)$item['id'] ?></strong><span><?= $e($this->roots[$item['root']] ?? '') ?></span></span>
<span class="sai-recent-date"><span><?= $e($l['lastUpdated']) ?></span><time datetime="<?= $e(date('c',(int)$item['tstamp'])) ?>"><?= $e(date('Y-m-d H:i',(int)$item['tstamp'])) ?></time></span>
<span class="sai-recent-action"><?= $e($l[$isCurrent?'viewingAnalysis':'openAnalysis']) ?></span>
</a></li>
<?php endforeach ?>
</ul></section>
<?php endif ?>
<?php if($this->hasKey) { $renderKey(); } ?>
</div>
