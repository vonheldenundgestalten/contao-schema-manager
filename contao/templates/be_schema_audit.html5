<?php
$e=static fn($s)=>htmlspecialchars((string)$s,ENT_QUOTES|ENT_SUBSTITUTE,'UTF-8');$l=$this->l;$run=$this->run;
$token='<input type="hidden" name="REQUEST_TOKEN" value="'.$e($this->token).'">';
?>
<div class="sai" data-schema-ai>
<header><h2><?= $e($l['auditTitle']) ?></h2><a href="?do=schema_manager&amp;key=ai&amp;root=<?= (int)$this->selectedRoot ?>"><?= $e($l['back']) ?></a></header>
<p><?= $e($l['auditHelp']) ?></p>
<?php if($this->error): ?><p class="tl_error"><?= $e($this->error) ?></p><?php endif ?>
<?php if($this->message): ?><p class="tl_confirm"><?= $e($this->message) ?></p><?php endif ?>
<?php foreach($this->draftHomes as $home): ?><p class="tl_info"><?= $e(sprintf($l['draftHome'],$home['name'],$home['language'])) ?> <a href="?do=schema_manager&amp;table=tl_schema_translation&amp;act=edit&amp;id=<?= (int)$home['id'] ?>"><?= $e($l['auditEdit']) ?></a></p><?php endforeach ?>
<?php if(!$run): ?>
<form method="post" data-turbo="false"><?= $token ?><input type="hidden" name="ai_action" value="start"><input type="hidden" name="stage" value="audit"><input type="hidden" name="mode" value="improve">
<div class="sai-fields"><label><?= $e($l['root']) ?><select name="root"><?php foreach($this->roots as $id=>$name): ?><option value="<?= (int)$id ?>" <?= (int)$id===(int)$this->selectedRoot?'selected':'' ?>><?= $e($name) ?></option><?php endforeach ?></select></label></div>
<label><input type="checkbox" name="multilingual" value="1" checked><?= $e($l['multilingual']) ?></label>
<button class="tl_submit"><?= $e($l['auditPrepare']) ?></button></form>
<?php else: ?>
<section><h3><?= $e($l['run']) ?> #<?= (int)$this->runId ?></h3><p><?= count($run['processed']) ?> / <?= count($run['inventory']['sources']) ?> <?= $e($l['sources']) ?></p>
<?php if($run['queue']): ?><form method="post" data-sai-run data-cursor="<?= $e(\VHUG\SchemaManagerBundle\Ai\AnalysisRunner::cursor($run)) ?>" data-waiting-label="<?= $e($l['auditRunning']) ?>" data-phase="analyze" data-total="<?= count($run['inventory']['sources']) ?>" data-remaining="<?= count($run['queue']) ?>" data-turbo="false"><?= $token ?><p data-sai-loading><?= $e($l['controlsLoading']) ?></p><button type="button" class="tl_submit" data-sai-start disabled><?= $e($l['auditScan']) ?></button><button type="button" class="tl_submit" data-sai-stop hidden><?= $e($l['stop']) ?></button><p data-sai-progress data-label="<?= $e($l['auditRunning']) ?>"></p></form><?php endif ?>
<?php foreach($run['warnings'] as $warning): ?><p class="tl_info"><?= $e($warning) ?></p><?php endforeach ?></section>
<form method="post" data-turbo="false"><?= $token ?><input type="hidden" name="ai_action" value="retire">
<?php foreach($run['auditResults'] as $key=>$result): ?>
<details class="sai-entity"><summary><strong><?= $e($result['title']) ?></strong> <small><?= $e($result['language']??'') ?></small> · <?= count($result['nodes']) ?> <?= $e($l['auditNodes']) ?></summary>
<p><a href="<?= $e($result['url']) ?>" target="_blank" rel="noopener"><?= $e($result['url']) ?></a></p>
<?php foreach($result['errors'] as $error): ?><p class="tl_error"><?= $e($error) ?></p><?php endforeach ?>
<?php foreach($result['nodes'] as $node): ?><div class="sai-proposal"><strong><?= $e($node['label']) ?></strong><p><?= $e($node['managed']?$l['auditManaged']:$l['auditAdditional']) ?></p><code><?= $e($node['id']) ?></code><details><summary><?= $e($l['auditData']) ?></summary><pre style="white-space:pre-wrap;overflow-wrap:anywhere"><?= $e(json_encode($node['data'],JSON_PRETTY_PRINT|JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES)) ?></pre><?php if(!$node['managed']&&$node['replacementData']): ?><pre style="white-space:pre-wrap;overflow-wrap:anywhere"><?= $e(json_encode($node['replacementData'],JSON_PRETTY_PRINT|JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES)) ?></pre><?php endif ?></details>
<?php if(!$node['managed']&&$node['replacement']): ?><p><?= $e($l['auditReplacement']) ?> <code><?= $e($node['replacement']) ?></code></p><p><?= $e($node['differences']?implode(', ',$node['differences']):$l['auditCovered']) ?></p><?php endif ?></div><?php endforeach ?>
<?php if(!$result['elements']): ?><p><?= $e($l['auditUnmapped']) ?></p><?php endif ?>
<?php foreach($result['elements'] as $item): ?><div class="sai-proposal"><strong><?= $e($l['auditElement']) ?> #<?= (int)$item['id'] ?></strong> <a href="?do=<?= $e($item['module']??'article') ?>&amp;table=tl_content&amp;act=edit&amp;id=<?= (int)$item['id'] ?>"><?= $e($l['auditEdit']) ?></a>
<?php foreach($item['reasons'] as $reason): ?><p><?= $e($reason) ?></p><?php endforeach ?>
<?php if($item['status']==='disabled'): ?><p><?= $e($l['auditDisabled']) ?></p><?php elseif($item['ready']&&$run['status']==='complete'): ?><label><input type="checkbox" name="retire[]" value="<?= $e($key.'|'.$item['id']) ?>"> <?= $e($l['auditSelect']) ?></label><?php endif ?></div><?php endforeach ?>
</details><?php endforeach ?>
<?php if($run['status']==='complete'): ?><p><?= $e($l['auditRetireHelp']) ?></p><button class="tl_submit"><?= $e($l['auditRetire']) ?></button><?php endif ?></form>
<?php endif ?></div>
