<?php $l = $this->labels; $e = static fn ($v) => htmlspecialchars((string)$v, ENT_QUOTES, 'UTF-8'); ?>
<div class="sg-map" data-schema-graph>
  <div class="sg-heading"><div><h2><?= $e($l['title']) ?></h2><p><?= $e($l['intro']) ?></p></div><a href="?do=schema_manager" data-turbo="false"><?= $e($l['back']) ?></a></div>
  <div class="sg-toolbar">
    <label><?= $e($l['search']) ?><input type="search" data-sg-search placeholder="<?= $e($l['searchHint']) ?>"></label>
    <label><?= $e($l['select']) ?><select data-sg-select><option value=""><?= $e($l['select']) ?></option></select></label>
    <button type="button" class="tl_submit" data-sg-fit><?= $e($l['fit']) ?></button>
    <button type="button" class="tl_submit" data-sg-reset><?= $e($l['reset']) ?></button>
    <label class="sg-check"><input type="checkbox" data-sg-isolated> <?= $e($l['isolated']) ?></label>
  </div>
  <p data-sg-summary role="status" aria-live="polite"></p>
  <div class="sg-workspace"><div class="sg-canvas" data-sg-canvas role="img" aria-label="<?= $e($l['canvas']) ?>"></div>
    <aside class="sg-details" data-sg-details aria-live="polite"><h3><?= $e($l['select']) ?></h3><p><?= $e($l['help']) ?></p></aside></div>
  <p class="sg-note"><?= $e($l['note']) ?></p>
  <noscript><p><?= $e($l['noJs']) ?></p></noscript>
  <script type="application/json" data-sg-data><?= $this->payload ?></script>
</div>
